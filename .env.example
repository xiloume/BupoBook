# Base SQLite (chemin relatif au dossier prisma/)
DATABASE_URL="file:../data/bupobook.db"

# Dossier de stockage des images uploadées (relatif à la racine du projet)
DATA_DIR="./data"

# Secret de session — à générer avec : openssl rand -hex 32
SESSION_SECRET="change-me"

# Passer à "true" quand le site est servi en HTTPS (cookie Secure)
SESSION_SECURE="false"

PORT=8520

# SSO � Se connecter avec BupoHub �
APP_URL="https://bupobook.bupohub.fr"
BUPOHUB_URL="https://bupohub.fr"
BUPOHUB_CLIENT_ID=""
BUPOHUB_CLIENT_SECRET=""
